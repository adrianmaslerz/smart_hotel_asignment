MINIO_SECRET_KEY=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_PORT=9000
MINIO_HOST=minio
# MinIO (S3-compatible)

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=redis
